# Terraform working files & secrets — never committed
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
crash.log
crash.*.log

# Personal overrides — never committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config (may contain credentials)
.terraformrc
terraform.rc

# Variable files (may contain secrets) — only *.example.tfvars may be committed
*.tfvars
!*.example.tfvars

# NOTE: .terraform.lock.hcl is intentionally NOT ignored (committed for reproducibility).

# Shared CI/CD work (CICD-01)
*.tfstate.*
.env
.superpowers/

# Exception: child-module lock files are NOT used by Terraform (only the
# root module's lock matters), so standalone validation inside a module
# dir must not pollute commits.
modules/*/.terraform.lock.hcl
